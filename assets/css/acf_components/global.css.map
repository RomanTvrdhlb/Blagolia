[class*=col-] .acf-row {
  margin: 0;
}
[class*=col-] .acf-table tbody .acf-label {
  display: none;
}
[class*=col-] .acf-table tbody tr {
  margin-bottom: 0 !important;
  flex-grow: 1;
  display: flex;
}
[class*=col-] .acf-table tbody tr td:nth-of-type(2) {
  flex-grow: 1;
}
[class*=col-] .acf-table tbody .image-wrap {
  max-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
[class*=col-] .acf-table tbody .acf-field-image img {
  margin: 0 auto;
  width: 100%;
  object-fit: contain;
}

