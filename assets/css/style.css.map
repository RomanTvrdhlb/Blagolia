}
.section-related .product-card__body {
  display: flex;
  flex-direction: column;
  height: 100%;
  gap: clamp(8px, 1.1111vw, 16px);
}
.section-related .product-card__body p {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(16px, 1.25vw, 18px);
  line-height: 150%;
