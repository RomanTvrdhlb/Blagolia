}
@media (max-width: 1024px) {
  .header .main-nav ul {
    flex-direction: column;
    align-items: flex-start;
  }
}
.header .main-nav ul a {
  color: var(--cl-b);
  font-family: var(--font-family);
  font-size: 16px;
  font-weight: normal;
  line-height: 109%;
  white-space: nowrap;
}
@media (hover: hover) {
  .header .main-nav ul a:hover {
    color: var(--cl-e);
  }
}
@media (hover: none) {
  .header .main-nav ul a:active {
    color: var(--cl-e);
  }
}

.footer {
  position: relative;
  background-color: var(--cl-c);
}
@media (min-width: 576px) {
  .footer .logo {
    margin-right: auto;
  }
}
.footer__inner {
  display: grid;
  align-items: center;
  grid-template-columns: 1fr clamp(200px, 29.99vw, 350px) auto;
  gap: 40px clamp(15px, 1.96vw, 20px);
  padding: clamp(45px, 7.17vw, 75px) 0;
}
@media (max-width: 575px) {
  .footer__inner {
    display: flex;
    flex-direction: column;
  }
}

.modal {
  max-width: 620px;
  width: 90vw;
  background: var(--bg-c);
}
.modal__container {
  display: flex;
  justify-content: center;
  margin: 0 auto;
}