  padding: clamp(24px, 3.3333vw, 48px) clamp(24px, 2.2222vw, 32px) clamp(18px, 4.4444vw, 64px);
}
.modal [data-loader]::before {
  background-color: rgba(217, 219, 218, 0);
  inset: -5px;
}
.modal [data-loader=true]::before {
  opacity: 1;
}
.modal .wpcf7 {
  align-self: center;
  width: 100%;
  max-width: 680px;
  margin-top: 0;
}
.modal[data-popup=modal_220] {
  max-width: clamp(400px, 38.1944vw, 550px);
  padding: clamp(34px, 3.3333vw, 48px) clamp(24px, 2.2222vw, 32px) 30px;
}
.modal .editor img,
.modal .editor picture,
.modal .editor svg {
  width: clamp(110px, 12.5vw, 180px);
  height: clamp(110px, 12.5vw, 180px);
  margin: 20px 0 10px;
  display: inline-block;
}
.modal::before {
  position: absolute;
  content: "";
  z-index: -1;
  pointer-events: none;
  background: rgba(217, 219, 218, 0.55);
  inset: 0;
}
.modal_box {
  width: 100%;
}
.modal__container {
  width: 100%;
  display: flex;
  justify-content: center;
  margin: 0 auto;
}
.modal .main-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.modal .main-form__cta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(16px, 1.6667vw, 24px);
}
@media (max-width: 767px) {
  .modal .main-form__cta {
    grid-template-columns: 100%;
  }
}
.modal .main-form label {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
}
.modal .main-form label > span:not([class]) {
  padding-left: 16px;
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-700);
  padding-left: 16px;
  order: -1;
}
.modal .main-form label > span:not([class]) i {
  font-family: var(--font3);
  font-weight: 400;
  font-size: 12px;
  font-style: normal;
  color: var(--error-bg);
  margin-left: 4px;
  display: inline-block;
  position: relative;
  top: -5px;
}
.modal .main-form label input {
  border: 1px solid var(--neutral-300);
  padding: 0px 10px 0px 16px;
  width: 100%;
  height: 50px;
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-700);
  transition: all 0.3s;
}
.modal .main-form label input::placeholder {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-500);
}
.modal .main-form label input:focus {
  border-color: var(--main-green);
}
.modal .main-form label textarea {
  border: 1px solid var(--neutral-300);
  padding: 0px 10px 0px 16px;
  width: 100%;
  height: 50px;
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-700);
  min-height: 150px;
  transition: all 0.3s;
  background: transparent;
}
.modal .main-form label textarea:focus {
  border-color: var(--main-green);
}
.modal .main-form label textarea::placeholder {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-500);
}
.modal .main-form .main-button {
  width: 100%;
  position: relative;
  max-width: 245px;
  padding: 16px 50px;
  margin-top: clamp(12px, 2.7778vw, 40px);
  align-self: center;
}
.modal .main-form .wpcf7 {
  position: relative;
  z-index: 1;
}
.modal .main-form .wpcf7-form-control-wrap {
  display: flex;
}
.modal .main-form .wpcf7-spinner {
  display: none;
}
.modal .main-form .wpcf7-not-valid-tip {
  bottom: 2px;
  left: 20px;
  position: absolute;
  opacity: 0;
  transition: opacity 0.2s;
  transition-delay: 0.2s;
}
.modal .main-form .wpcf7-response-output {
  display: none;
  position: absolute;
}
.modal .main-form__box {
  display: flex;
  flex-direction: column;
  gap: clamp(16px, 1.6667vw, 24px);
}
.modal .main-form__wrapp {
  display: flex;
  flex-direction: column;
  gap: clamp(16px, 1.6667vw, 24px);
  height: 100%;
}
.modal .main-form__wrapp .main-button {
  margin-top: auto;
  max-width: 249px;
}
@media (min-width: 768px) {
  .modal .main-form__wrapp .main-button {
    align-self: flex-end;
  }
}
@media (max-width: 767px) {
  .modal .main-form__wrapp .main-button {
    max-width: 450px;
    margin-top: 0;
  }
}
@media (max-width: 575px) {
  .modal .main-form__wrapp .main-button {
    max-width: 100%;
  }
}
.modal .main-form__wrapp label textarea {
  padding: 12px 10px 12px 16px;
  height: clamp(227px, 17.0139vw, 245px);
}

.section-product {
