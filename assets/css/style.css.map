  .section-product__box {
    gap: 36px;
    grid-template-columns: 100%;
  }
}
.section-product__list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-self: start;
  margin-top: 48px;
}
@media (max-width: 1024px) {
  .section-product__list {
    margin-top: -14px;
  }
}
.section-product__thumb {
  width: 100%;
  height: 100%;
  max-width: 610px;
