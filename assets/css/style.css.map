  padding: 0;
  height: 100%;
}
.section-related .product-card.mode .product-card__date {
  font-family: var(--font-family);
  font-weight: 400;
  font-size: 14px;
  color: var(--neutral-600);
  margin-top: calc(clamp(2px, 0.5556vw, 8px) * -1);
}
@media (max-width: 575px) {
  .section-related .product-card.mode .product-card__date {
    margin-top: 0;
  }
}
.section-related .product-card.mode .product-card__body {
