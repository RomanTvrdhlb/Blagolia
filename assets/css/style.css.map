[data-loader] {
  position: relative;
  z-index: 1000;
}
[data-loader]::before, [data-loader]::after {
  content: "";
  position: absolute;
  z-index: 10;
  pointer-events: none;
  opacity: 1;
  transition: all 0.3s ease;
}
[data-loader]::before {
  inset: -2px;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(6px);
}
[data-loader]::after {
  top: 50%;
  left: 50%;
  width: clamp(100px, 12vw, 160px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--loader);
  animation: spin 1.2s linear infinite;
  transform: translate(-50%, -50%);
  padding: clamp(12px, 2vw, 24px);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

@keyframes spin {
  to {
    transform: translate(-50%, -50%) rotate(1turn);
  }
}
[data-loader=false]::before,
[data-loader=false]::after {
  opacity: 0;
}

:root {
  --primary-color: #007aff;
  --primary-light: #e0f0ff;
  --secondary-color: #6c757d;
  --success-color: #34c759;
  --warning-color: #ffcc00;
  --error-color: #ff3b30;
  --background-color: #f2f2f7;
  --surface-color: var(--bg-j);
  --text-primary: #000000;
  --text-secondary: var(--cl-a);
  --text-disabled: #c7c7cc;
  --border-color: #d1d1d6;
  --shadow-color: rgba(0, 0, 0, 0.08);
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 10px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
}

.custom-select {
  position: relative;
  width: 100%;
  font-size: 16px;
  user-select: none;
  width: fit-content;
  min-width: 150px;
  min-height: 48px;
}
.custom-select .sprite {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}
.custom-select .sprite svg {
  width: 100%;
  height: auto;
}
.custom-select .select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 16px 5px;
  border-radius: 12px;
  height: 100%;
  border: 1px solid var(--br-g);
  background: transparent;
  cursor: pointer;
  min-height: 48px;
  transition: all var(--transition-normal);
}
.custom-select .select-field.active {
  border-radius: 12px 12px 0 0;
  background: var(--cl-a);
  border-bottom-color: transparent;
}
.custom-select .select-field:hover .option-label {
  color: var(--cl-k);
}
.custom-select .select-field:hover .arrow-down {
  color: var(--cl-k);
}
.custom-select .select-field:hover .select-field__icon i {
  color: var(--cl-k);
}
.custom-select .select-field__icon {
  display: flex;
  margin-right: 5px;
}
.custom-select .select-field__icon i {
  width: 16px;
  height: 16px;
  color: #3F3F3F;
}
.custom-select .select-field__icon i svg {
  transition: all var(--transition-normal);
  width: 100%;
  height: auto;
}
.custom-select .selected-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  min-height: 24px;
  color: currentColor;
  width: 100%;
  z-index: 2;
  align-items: center;
  row-gap: 6px;
}
.custom-select .placeholder {
  color: inherit;
}
.custom-select .arrow-down {
  display: flex;
  height: 16px;
  color: inherit;
  transition: transform var(--transition-normal), color var(--transition-normal);
}
.custom-select .select-field.active .arrow-down {
  transform: scaleY(-1);
}
.custom-select .options-container {
  position: absolute;
  top: calc(100% - 1px);
  left: 0;
  width: 100%;
  max-height: 0;
  overflow: hidden;
  background: var(--cl-a);
  border-radius: 0px 0px 12px 12px;
  z-index: 10;
  opacity: 0;
  transition: all var(--transition-normal);
  list-style: none;
  border: 1px solid transparent;
  border-top: none;
}
.custom-select .options-container::-webkit-scrollbar-thumb {
  border-radius: 4px;
  background: #93785f;
}
.custom-select .options-container::-webkit-scrollbar-track {
  background-color: transparent;
}
.custom-select .options-container::-webkit-scrollbar {
  width: 3px;
  border-radius: 16px;
  display: block;
}
.custom-select .options-container.active {
  opacity: 1;
  max-height: 240px;
  overflow-y: auto;
  border-color: var(--br-g);
}
.custom-select .option {
  display: flex;
  align-items: center;
  cursor: pointer;
  transition: background-color var(--transition-fast);
}
.custom-select .option:hover .option-text {
  color: var(--cl-k);
}
@media (hover: hover) {
  .custom-select .option:not(.disabled):hover {
    background-color: var(--bg-l);
  }
}
@media (hover: none) {
  .custom-select .option:not(.disabled):active {
    background-color: var(--bg-l);
  }
}
.custom-select .option.active {
  pointer-events: none;
}
.custom-select .option.active .option-text {
  background: rgba(178, 197, 255, 0.25);
}
.custom-select .option.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.custom-select .option-text {
  display: flex;
  padding: 12px 16px;
  align-items: center;
  gap: 10px;
  width: 100%;
  cursor: pointer;
  transition: all 0.3s;
  color: var(--cl-j);
  font-family: var(--font-family);
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: 130%;
  height: 45px;
}
.custom-select .selected-option {
  display: flex;
  align-items: center;
  width: fit-content;
  background-color: transparent;
  border-radius: 0;
  padding: 0;
  margin-right: 0;
}
.custom-select .option-label {
  flex-grow: 1;
  overflow: hidden;
  width: 100%;
  display: flex;
  align-items: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: all 0.3s;
  color: var(--cl-r);
  font-family: var(--font-family);
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: 130%;
  margin-right: 7px;
}
.custom-select .remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  background-color: var(--bg-g);
  cursor: pointer;
  color: var(--cl-a);
  border-radius: 4px;
  margin-right: -10px;
  flex-shrink: 0;
}
.custom-select .remove-btn svg {
  width: 10px;
  height: 10px;
}
.custom-select .selected-values {
  margin-top: var(--spacing-md);
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}
.custom-select .selected-value-item {
  display: flex;
  align-items: center;
  background-color: var(--primary-light);
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm);
  color: var(--primary-color);
}
.custom-select .placeholder {
  color: #3F3F3F;
  font-family: var(--font-family);
  font-size: 18px;
  font-style: normal;
  font-weight: 400;
  line-height: normal;
}
.custom-select.multiple .selected-option {
  background-color: rgba(178, 197, 255, 0.2);
  border-radius: var(--radius-sm);
  padding: 2px var(--spacing-sm);
  margin-right: var(--spacing-xs);
}

