/* stylelint-disable */
.section-global {
  padding-bottom: var(--default-padding);
}
.section-global__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-global__inner .editor {
  max-width: 1000px;
  align-self: center;
}
.section-global__image {
  width: 100vw;
  height: clamp(400px, 41.6667vw, 600px);
  display: flex;
  margin-top: var(--default-gap);
}
.section-global__image img,
.section-global__image picture {
  height: 100%;
  object-fit: cover;
  width: 100%;
}
@media (max-width: 575px) {
  .section-global__image {
    max-height: 300px;
  }
}