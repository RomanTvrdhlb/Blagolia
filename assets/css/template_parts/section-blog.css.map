/* stylelint-disable */
/* stylelint-disable */
.section-blog {
  padding-bottom: var(--default-padding);
}
.section-blog__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-blog__posts {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: var(--gap);
}
@media (max-width: 575px) {
  .section-blog__posts {
    grid-template-columns: 100%;
  }
}
.section-blog .post-card__thumb {
  width: 100%;
  display: flex;
  height: 300px;
  overflow: hidden;
}
.section-blog .post-card__thumb img,
.section-blog .post-card__thumb picture {
  transition: all 0.3s;
  width: 100%;
  height: 100%;
}
.section-blog .post-card__date {
  font-family: var(--font-family);
  font-weight: 400;
  font-size: clamp(12px, 0.9722vw, 14px);
  color: var(--neutral-600);
  margin-top: calc(clamp(8px, 0.8333vw, 12px) * -1);
}
.section-blog .post-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  padding: var(--gap);
  border: 1px solid var(--neutral-200);
  border-top: none;
}
.section-blog .post-card__excerpt {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-600);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.section-blog .post-card__title {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(22px, 1.9444vw, 28px);
  color: var(--neutral-700);
  line-height: 105%;
}
@media (max-width: 1024px) {
  .section-blog .post-card .main-button {
    width: 100%;
    max-width: 100%;
  }
}
@media (hover: hover) {
  .section-blog .post-card:hover .post-card__thumb img,
  .section-blog .post-card:hover .post-card__thumb picture {
    transform: scale(1.04);
  }
}
@media (hover: none) {
  .section-blog .post-card:active .post-card__thumb img,
  .section-blog .post-card:active .post-card__thumb picture {
    transform: scale(1.04);
  }
}