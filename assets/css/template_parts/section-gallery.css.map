/* stylelint-disable */
/* stylelint-disable */
.section-gallery {
  padding-bottom: var(--default-padding);
}
.section-gallery__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-gallery .main-slider {
  width: 100%;
}
.section-gallery .main-slider .swiper-container {
  width: 100%;
}
@media (min-width: 1025px) {
  .section-gallery .main-slider .slider-pagination {
    display: none;
  }
}
@media (min-width: 1025px) {
  .section-gallery .main-slider .swiper-wrapper {
    transform: none !important;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
}
@media (min-width: 1025px) {
  .section-gallery .main-slider .swiper-slide {
    width: 100%;
    height: 100%;
  }
}
@media (max-width: 1024px) {
  .section-gallery .main-slider .swiper-slide {
    width: 464px;
  }
}
.section-gallery .main-slider.mode .swiper-slide a {
  display: flex;
  aspect-ratio: 1;
  width: 100%;
  overflow: hidden;
}
.section-gallery .main-slider.mode .swiper-slide a img, .section-gallery .main-slider.mode .swiper-slide a picture {
  transition: all 0.3s;
  width: 100%;
  height: 100%;
}
.section-gallery .main-slider.mode .swiper-slide a:hover img, .section-gallery .main-slider.mode .swiper-slide a:hover picture {
  transform: scale(1.04);
}
@media (max-width: 1024px) {
  .section-gallery .main-slider.mode .swiper-slide a {
    max-height: 550px;
  }
}