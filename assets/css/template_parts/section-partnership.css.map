/* stylelint-disable */
/* stylelint-disable */
.section-partnership {
  margin-bottom: var(--default-padding);
}
.section-partnership__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-partnership__inner .editor {
  align-self: center;
  max-width: 950px;
}
.section-partnership__inner .main-button {
  align-self: center;
}
@media (max-width: 575px) {
  .section-partnership__inner .main-button {
    width: 100%;
  }
}
.section-partnership__list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-gap: var(--gap);
}
@media (max-width: 1024px) and (min-width: 768px) {
  .section-partnership__list {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 767px) {
  .section-partnership__list {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
}
.section-partnership__item {
  padding: var(--gap);
  display: flex;
  align-items: center;
  gap: var(--gap);
  flex-direction: column;
  border: 1px solid var(--neutral-200);
  width: 100%;
  height: 100%;
}
.section-partnership__item p {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(16px, 1.25vw, 18px);
  line-height: 150%;
  text-align: center;
  color: var(--neutral-600);
}
.section-partnership__icon {
  display: flex;
  width: 36px;
  height: 36px;
}
.section-partnership__icon svg,
.section-partnership__icon img {
  width: 100%;
  height: auto;
}
.section-partnership .pretitle {
  text-align: center;
}
@media (min-width: 1025px) {
  .section-partnership .pretitle {
    height: 66px;
  }
}