/* stylelint-disable */
.section-steps {
  padding-bottom: var(--default-padding);
}
.section-steps .breadcrumbs {
  margin-top: calc(var(--default-padding) * -1);
}
.section-steps__inner {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--default-gap) var(--gap);
}
.section-steps__inner .editor {
  max-width: 900px;
  justify-self: center;
  grid-column: 1/-1;
}
@media (max-width: 1024px) {
  .section-steps__inner .editor {
    order: -2;
  }
}
@media (max-width: 1024px) {
  .section-steps__inner {
    grid-template-columns: 100%;
  }
}
.section-steps__list {
  display: flex;
  flex-direction: column;
  gap: 24px var(--gap);
}
@media (max-width: 1024px) {
  .section-steps__list {
    margin-top: -12px;
  }
}
.section-steps__image {
  width: 100%;
  height: 100%;
  display: flex;
}
.section-steps__image img,
.section-steps__image picture {
  height: 100%;
  width: 100%;
}
@media (max-width: 1024px) {
  .section-steps__image {
    max-height: 400px;
    order: -1;
  }
}
@media (max-width: 1024px) {
  .section-steps .pretitle {
    font-family: var(--font-family2);
    font-weight: 400;
  }
}
.section-steps__item {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: var(--gap);
  border: 1px solid var(--neutral-200);
  width: 100%;
  height: 100%;
}
.section-steps__item p {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(16px, 1.25vw, 18px);
  line-height: 150%;
  color: var(--neutral-600);
}
@media (max-width: 1024px) {
  .section-steps__item p {
    font-family: var(--font-family2);
    font-weight: 400;
  }
}
@media (max-width: 1024px) and (min-width: 576px) {
  .section-steps__item {
    gap: 24px;
    padding: 24px;
  }
}