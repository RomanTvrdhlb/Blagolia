/* stylelint-disable */
.section-about {
  padding-bottom: var(--default-padding);
}
.section-about__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-about__box {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px var(--gap);
}
@media (max-width: 1024px) {
  .section-about__box {
    grid-template-columns: 100%;
  }
}