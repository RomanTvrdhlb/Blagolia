/* stylelint-disable */
/* stylelint-disable */
.section-news {
  padding-bottom: var(--default-padding);
}
.section-news__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-news .post-card__thumb {
  width: 100%;
  display: flex;
  height: 300px;
  overflow: hidden;
}
.section-news .post-card__thumb img,
.section-news .post-card__thumb picture {
  transition: all 0.3s;
  width: 100%;
  height: 100%;
}
.section-news .post-card__date {
  font-family: var(--font-family);
  font-weight: 400;
  font-size: clamp(12px, 0.9722vw, 14px);
  color: var(--neutral-600);
  margin-top: calc(clamp(8px, 0.8333vw, 12px) * -1);
}
.section-news .post-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  padding: var(--gap);
  border: 1px solid var(--neutral-200);
  border-top: none;
}
.section-news .post-card__excerpt {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: 18px;
  line-height: 150%;
  color: var(--neutral-600);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.section-news .post-card__title {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(22px, 1.9444vw, 28px);
  color: var(--neutral-700);
  line-height: 105%;
}
@media (max-width: 1024px) {
  .section-news .post-card .main-button {
    width: 100%;
    max-width: 100%;
  }
}
@media (hover: hover) {
  .section-news .post-card:hover .post-card__thumb img,
  .section-news .post-card:hover .post-card__thumb picture {
    transform: scale(1.04);
  }
}
@media (hover: none) {
  .section-news .post-card:active .post-card__thumb img,
  .section-news .post-card:active .post-card__thumb picture {
    transform: scale(1.04);
  }
}
.section-news .main-slider {
  width: 100%;
}
.section-news .main-slider .swiper-container {
  width: 100%;
}
@media (min-width: 1025px) {
  .section-news .main-slider .slider-pagination {
    display: none;
  }
}
@media (min-width: 1025px) {
  .section-news .main-slider .swiper-wrapper {
    transform: none !important;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
}
@media (min-width: 1025px) {
  .section-news .main-slider .swiper-slide {
    width: 100%;
    height: 100%;
  }
}
@media (max-width: 1024px) {
  .section-news .main-slider .swiper-slide {
    width: 464px;
  }
}
.section-news .main-slider.mode .swiper-slide a {
  display: flex;
  aspect-ratio: 1;
  width: 100%;
  overflow: hidden;
}
.section-news .main-slider.mode .swiper-slide a img, .section-news .main-slider.mode .swiper-slide a picture {
  transition: all 0.3s;
  width: 100%;
  height: 100%;
}
.section-news .main-slider.mode .swiper-slide a:hover img, .section-news .main-slider.mode .swiper-slide a:hover picture {
  transform: scale(1.04);
}
@media (max-width: 1024px) {
  .section-news .main-slider.mode .swiper-slide a {
    max-height: 550px;
  }
}