/* stylelint-disable */
.section-certificates {
  padding-bottom: var(--default-padding);
}
.section-certificates__inner {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-certificates__inner .editor {
  max-width: 900px;
  align-self: center;
}
.section-certificates__list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap);
}
@media (max-width: 1024px) {
  .section-certificates__list {
    grid-template-columns: repeat(2, 1fr);
  }
}
.section-certificates .certificate {
  padding: clamp(8px, 1.6667vw, 24px);
  border: 1px solid var(--neutral-300);
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(8px, 1.1111vw, 16px);
}
.section-certificates .certificate__links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  position: absolute;
  inset: 0;
  z-index: 3;
  backdrop-filter: blur(10px);
  opacity: 0;
  transition: all 0.3s;
}
.section-certificates .certificate__links a {
  width: clamp(54px, 4.4444vw, 64px);
  height: clamp(54px, 4.4444vw, 64px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--main-yellow);
  transition: all 0.3s;
}
.section-certificates .certificate__links a i.sprite {
  width: 28px;
  height: auto;
}
.section-certificates .certificate__links a i.sprite svg {
  width: 100%;
  object-fit: cover;
  height: auto;
}
@media (hover: hover) {
  .section-certificates .certificate__links a:hover {
    background: rgb(248.347826087, 185.0434782609, 3.652173913);
  }
}
@media (hover: none) {
  .section-certificates .certificate__links a:active {
    background: rgb(248.347826087, 185.0434782609, 3.652173913);
  }
}
.section-certificates .certificate__thumb {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  height: clamp(220px, 29.1667vw, 420px);
  overflow: hidden;
}
.section-certificates .certificate__thumb img,
.section-certificates .certificate__thumb picture {
  transition: all 0.3s;
  width: 100%;
  height: 100%;
}
@media (max-width: 1024px) {
  .section-certificates .certificate__thumb {
    height: clamp(220px, 46.88vw, 480px);
  }
}
@media (min-width: 576px) {
  .section-certificates .certificate__thumb {
    margin-bottom: clamp(8px, 1.1111vw, 16px);
  }
}
.section-certificates .certificate__thumb:hover .certificate__links {
  opacity: 1;
}
.section-certificates .certificate__title {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(16px, 2.73vw, 28px);
  text-align: center;
  color: var(--neutral-700);
  line-height: 100%;
}
.section-certificates .certificate p {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(12px, 1.76vw, 18px);
  line-height: 150%;
  text-align: center;
  color: var(--neutral-600);
  max-width: 280px;
}
@media (hover: hover) {
  .section-certificates .certificate:hover .certificate__thumb img,
  .section-certificates .certificate:hover .certificate__thumb picture {
    transform: scale(1.04);
  }
}
@media (hover: none) {
  .section-certificates .certificate:active .certificate__thumb img,
  .section-certificates .certificate:active .certificate__thumb picture {
    transform: scale(1.04);
  }
}