/* stylelint-disable */
/* stylelint-disable */
.section-statistics {
  margin-bottom: var(--default-padding);
  padding: clamp(24px, 3.4722vw, 50px) 0;
  background: var(--main-green);
}
.section-statistics__list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: min(14.7917vw, 213px);
}
@media (max-width: 1024px) {
  .section-statistics__list {
    gap: 24px;
  }
}
@media (max-width: 767px) {
  .section-statistics__list {
    grid-template-columns: repeat(2, 1fr);
    gap: 50px;
  }
}
.section-statistics__item {
  gap: clamp(8px, 1.1111vw, 16px);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.section-statistics__item p {
  font-family: var(--font-family);
  font-weight: 500;
  font-size: clamp(16px, 1.3889vw, 20px);
  line-height: 145%;
  text-align: center;
  color: var(--neutral-200);
}
@media (max-width: 1024px) {
  .section-statistics__item p {
    max-width: 160px;
  }
}
.section-statistics__item:nth-of-type(3) p {
  max-width: 170px;
}
.section-statistics__item:first-of-type::before {
  content: none;
}
@media (max-width: 767px) {
  .section-statistics__item:first-of-type::after {
    position: absolute;
    content: "";
    left: 0;
    background: rgba(242, 243, 242, 0.2);
    width: 100%;
    height: 1px;
    border-radius: 2px;
    bottom: -25px;
  }
}
@media (max-width: 767px) {
  .section-statistics__item:nth-of-type(2)::after {
    position: absolute;
    content: "";
    left: 0;
    background: rgba(242, 243, 242, 0.2);
    width: 100%;
    height: 1px;
    border-radius: 2px;
    bottom: -25px;
  }
}
.section-statistics__item::before {
  position: absolute;
  content: "";
  left: calc(min(14.7917vw, 213px) / 2 * -1);
  background: rgba(242, 243, 242, 0.2);
  width: 1px;
  height: 141px;
  border-radius: 2px;
  top: 50%;
  transform: translateY(-50%);
}
@media (max-width: 1024px) {
  .section-statistics__item::before {
    left: -12px;
  }
}
@media (max-width: 767px) {
  .section-statistics__item::before {
    left: -25px;
    height: 100%;
  }
}
.section-statistics__title {
  line-height: 100%;
  font-family: var(--font-family);
  font-weight: 600;
  font-size: clamp(48px, 3.8889vw, 56px);
  text-transform: uppercase;
  text-align: center;
  color: var(--main-yellow);
}