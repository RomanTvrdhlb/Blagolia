/* stylelint-disable */
.section-video {
  padding-bottom: var(--default-padding);
}
.section-video__wrapp {
  display: flex;
  flex-direction: column;
  gap: var(--default-gap);
}
.section-video__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: clamp(100px, 17.3611vw, 250px);
  height: clamp(100px, 17.3611vw, 250px);
  border-radius: 100%;
  background: rgba(236, 236, 236, 0.05);
  border: 2.5px solid #fdfdfd;
  backdrop-filter: blur(16.6666660309px);
}
.section-video__play .sprite {
  width: clamp(31px, 6.8056vw, 98px);
  transition: all 0.3s;
  height: clamp(34px, 7.6389vw, 110px);
  margin-right: -10%;
}
.section-video__play .sprite svg {
  width: 100%;
  height: auto;
}
.section-video__poster {
  width: 100%;
  height: 100%;
  display: flex;
}
.section-video__poster img,
.section-video__poster picture,
.section-video__poster video,
.section-video__poster iframe {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.section-video__media {
  width: 100%;
  position: relative;
  z-index: 1;
  height: clamp(400px, 41.6667vw, 600px);
  display: flex;
}
.section-video__media img,
.section-video__media picture {
  height: 100%;
  width: 100%;
}
@media (max-width: 575px) {
  .section-video__media {
    height: 300px;
  }
}
@media (hover: hover) {
  .section-video__media:hover .section-video__play .sprite {
    transform: scale(1.05);
  }
}
@media (hover: none) {
  .section-video__media:active .section-video__play .sprite {
    transform: scale(1.05);
  }
}